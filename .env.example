# apps/api/.dev.vars (local) — in production use `wrangler secret put <NAME>`
DATABASE_URL=postgres://user:pass@localhost:5432/openuptime_dev   # local only; production uses the HYPERDRIVE binding
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4321    # public origin of the web app (API is proxied at /api)
WEB_ORIGIN=http://localhost:4321
CRON_SECRET=change-me                    # lets an external scheduler hit POST /internal/run-checks
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email (invitations, password reset, email alert channel, status page subscriptions).
# Local dev logs emails to the console. In production set EMAIL_FROM (Cloudflare Email Sending binding `EMAIL`).
# EMAIL_FROM=alerts@your-domain.com

# Close registration once you have your own account; people with a pending invitation can still join.
# DISABLE_SIGNUP=true

# Cloudflare Turnstile on the sign-up form: set both keys to enable it. Cloudflare's test keys for local dev:
# site 1x00000000000000000000AA (always passes), secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Local dev: monitors on localhost / private addresses are refused unless this is true.
# ALLOW_PRIVATE_TARGETS=true
