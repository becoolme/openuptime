# cp .env.docker.example .env   then edit
POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=change-me-openssl-rand-hex-32
PUBLIC_URL=http://localhost:8080

# Host port (default 8080)
# PORT=8080
# Run the published image instead of building from source: pin a version (:0.1.0) or follow :latest,
# then `docker compose pull && docker compose up -d`
# OPENUPTIME_IMAGE=ghcr.io/becoolme/openuptime:latest

# Set true when the app runs behind exactly one reverse proxy (Caddy, nginx, Traefik) that appends X-Forwarded-For:
# sign-in and sign-up rate limits then count per client address. Leave unset when the app is exposed directly.
# TRUST_PROXY=true

# Close registration once your own account exists (invited people can still join)
# DISABLE_SIGNUP=true
# Cloudflare Turnstile on the sign-up form (set both; needs a free widget in the Cloudflare dashboard)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# LEGAL_LINKS=true   # show "you agree to the Terms / Privacy" on sign-up; replace the bundled /terms and /privacy text first
# Days an invitation stays valid (default 7)
# INVITE_TTL_DAYS=7
# Lets an external scheduler call POST /internal/run-checks (header x-cron-secret); unset keeps /internal/* closed
# CRON_SECRET=

# Monitor internal services: by default targets on private, loopback and link-local addresses (and single-label names
# such as compose service names) are refused, so a signed-up user cannot probe your network. Turn on once you trust
# every account on this instance.
# ALLOW_PRIVATE_TARGETS=true
# Max connections of the shared Postgres pool (default 10)
# DB_POOL_MAX=10
# Target of the "Powered by" link on status pages (default https://openuptime.app)
# PRODUCT_URL=https://openuptime.app
# User-Agent sent by HTTP checks (default: OpenUptime/0.1 (+https://github.com/becoolme/openuptime))
# CHECK_USER_AGENT=
# URLs (comma-separated) a failed check fetches to tell "the target is down" from "this server is offline". Leave unset for
# three well-known public URLs; set it empty (SELFCHECK_URLS=) to turn the self-check off, e.g. on an isolated network.
# SELFCHECK_URLS=

# Multi-region checks (optional): remote probes from apps/probe (Docker image, any Node host, or Vercel). Monitors use
# them only when you pick regions for them. See apps/probe/README.md.
# PROBE_SECRET=
# PROBE_REGIONS={"us-east":"https://probe.example.app/api/probe/us-east","eu-central":"https://probe.example.app/api/probe/eu-central"}

# iOS push notifications (optional): an APNs Auth Key (.p8) and the app's ids. All four must be set. Use \n for line breaks
# in APNS_KEY. The key is tied to the app's bundle id, see /docs/self-host#apns.
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=

# Outgoing email (optional)
# EMAIL_FROM=alerts@example.com
# Resend: just the API key (EMAIL_FROM must be on a domain verified in Resend)
# RESEND_API_KEY=re_xxx
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# …or: SMTP_HOST=smtp.example.com  SMTP_PORT=587  SMTP_USER=…  SMTP_PASS=…  (SMTP_SECURE=true for port 465)

# "Sign in with GitHub" (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Plausible analytics (optional; the script URL defaults to https://plausible.io/js/script.js)
# PLAUSIBLE_DOMAIN=status.example.com
# PLAUSIBLE_SRC=https://stats.example.com/js/script.js
