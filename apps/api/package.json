{
  "name": "@openuptime/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.dev.vars src/dev.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build:node": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "build:glama": "esbuild scripts/glama-api.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/glama-api.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\""
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-validator": "^0.9.1",
    "@openuptime/db-pg": "workspace:*",
    "@openuptime/mcp-rest": "workspace:*",
    "@openuptime/repo": "workspace:*",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "jose": "6.2.12",
    "nodemailer": "^10.1.0",
    "sirv": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
