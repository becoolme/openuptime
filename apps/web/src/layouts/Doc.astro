---
import Base from "./Base.astro";
// Long-form static pages (privacy, terms, API reference). Both languages are in the markup;
// CSS shows the block matching <html lang>, which Base.astro's inline script sets from `ou_lang`.
const { title, updated, toc } = Astro.props as { title: string; updated?: string; toc?: boolean };
---
<Base title={`${title} · OpenUptime`} router={false}>
  <header class="doc-top">
    <div class="doc-top-in">
      <a href="/" class="doc-brand">
        <span class="doc-mk"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 4 12 2.5-6H21" /></svg></span>
        <b>OpenUptime</b>
      </a>
      <nav class="doc-links">
        <a href="/docs/mcp"><span lang="en">MCP</span><span lang="zh-CN">MCP</span></a>
        <a href="/docs/api"><span lang="en">API</span><span lang="zh-CN">API</span></a>
        <a href="/docs/embed"><span lang="en">Embed</span><span lang="zh-CN">嵌入</span></a>
        <a href="/docs/self-host"><span lang="en">Self-host</span><span lang="zh-CN">自托管</span></a>
      </nav>
      <div class="doc-nav">
        <a class="doc-signin" href="/login"><span lang="en">Sign in</span><span lang="zh-CN">登录</span></a>
      </div>
    </div>
  </header>
  <div class={toc ? "doc-layout has-toc" : "doc-layout"}>
  {toc && <aside class="doc-toc" id="doc-toc" aria-label="On this page"></aside>}
  <main class="doc">
    <slot />
    {updated && (
      <p class="doc-updated">
        <span lang="en">Last updated {updated}</span><span lang="zh-CN">最后更新：{updated}</span>
      </p>
    )}
  </main>
  </div>
  <footer class="site-foot">
    <div class="sf-wrap">
      <div class="sf-grid">
        <div>
          <a class="doc-brand sf-brand" href="/"><span class="doc-mk"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 4 12 2.5-6H21" /></svg></span><b>OpenUptime</b></a>
          <p class="sf-tag"><span lang="en">Open-source uptime monitoring and status pages for Cloudflare Workers and Postgres.</span><span lang="zh-CN">面向 Cloudflare Workers 与 Postgres 的开源可用性监控与状态页。</span></p>
          <a class="sf-status" id="sf-status" href="/status/openuptime" hidden><i></i><span id="sf-status-t"></span></a>
        </div>
        <div><h4><span lang="en">Product</span><span lang="zh-CN">产品</span></h4><a href="/#features"><span lang="en">Features</span><span lang="zh-CN">功能</span></a><a href="/"><span lang="en">Changelog</span><span lang="zh-CN">更新日志</span></a><a href="/"><span lang="en">Roadmap</span><span lang="zh-CN">路线图</span></a><a href="/status/openuptime"><span lang="en">System status</span><span lang="zh-CN">服务状态</span></a></div>
        <div><h4><span lang="en">Developers</span><span lang="zh-CN">开发者</span></h4><a href="/docs/api"><span lang="en">Docs</span><span lang="zh-CN">文档</span></a><a href="/docs/api"><span lang="en">API reference</span><span lang="zh-CN">API 参考</span></a><a href="/docs/mcp">MCP</a><a href="/docs/self-host"><span lang="en">Self-host</span><span lang="zh-CN">自托管</span></a><a href="/docs/embed"><span lang="en">Embed status</span><span lang="zh-CN">嵌入状态</span></a><a href="/">GitHub</a><a href="/"><span lang="en">Contributing</span><span lang="zh-CN">贡献指南</span></a></div>
        <div><h4><span lang="en">Community</span><span lang="zh-CN">社区</span></h4><a href="/"><span lang="en">Discussions</span><span lang="zh-CN">讨论区</span></a><a href="/"><span lang="en">Security</span><span lang="zh-CN">安全披露</span></a><a href="/privacy"><span lang="en">Privacy</span><span lang="zh-CN">隐私</span></a><a href="/terms"><span lang="en">Terms</span><span lang="zh-CN">服务条款</span></a></div>
      </div>
      <div class="sf-bot">
        <span><span lang="en">© 2026 OpenUptime contributors · MIT License</span><span lang="zh-CN">© 2026 OpenUptime 贡献者 · MIT 许可证</span></span>
        <span><span lang="en">Built in the open.</span><span lang="zh-CN">公开开发。</span></span>
        <div class="lang" id="lang-wrap">
          <button type="button" class="lang-btn" id="lang" aria-label="Language" aria-haspopup="menu" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/></svg>
            <span id="lang-cur">English</span>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <ul class="lang-menu" id="lang-menu" role="menu">
            <li><button type="button" role="menuitemradio" data-l="en">English</button></li>
            <li><button type="button" role="menuitemradio" data-l="zh-CN">简体中文</button></li>
            <li><button type="button" role="menuitemradio" data-l="ja">日本語</button></li>
            <li><button type="button" role="menuitemradio" data-l="es">Español</button></li>
          </ul>
        </div>
      </div>
    </div>
  </footer>
  <script is:inline>
    // Our own status page, when it exists.
    (function () {
      var zh = document.documentElement.lang === "zh-CN";
      var txt = { operational: zh ? "所有系统运行正常" : "All systems operational", degraded: zh ? "部分服务降级" : "Partial degradation", outage: zh ? "服务中断" : "Major outage" };
      fetch("/api/public/status/openuptime").then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
        if (!d || !txt[d.overall]) return;
        var a = document.getElementById("sf-status");
        a.className = "sf-status " + d.overall;
        document.getElementById("sf-status-t").textContent = txt[d.overall];
        a.hidden = false;
      }).catch(function () {});
    })();
    // Tiny syntax highlighter for the <pre> samples (curl commands, JSON, pseudo-schemas).
    (function () {
      var esc = function (t) { return t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); };
      var re = /("(?:\\.|[^"\\\n])*"|'(?:[^'\n])*')(\s*:)?|(#[^\n]*)|(\b(?:true|false|null)\b)|(\b\d[\d.]*\b)|(^|\s)(-[A-Za-z]|--[a-z-]+)(?=\s)|\b(curl|GET|POST|PATCH|DELETE)\b|(\.\.\.)/gm;
      document.querySelectorAll(".doc pre code").forEach(function (el) {
        var src = el.textContent || "";
        var out = "", last = 0, m;
        re.lastIndex = 0;
        while ((m = re.exec(src))) {
          out += esc(src.slice(last, m.index));
          var cls, txt = m[0];
          if (m[1]) { cls = m[2] ? "hk" : "hs"; out += '<span class="' + cls + '">' + esc(m[1]) + "</span>" + (m[2] ? esc(m[2]) : ""); last = re.lastIndex; continue; }
          if (m[3]) cls = "hc";
          else if (m[4]) cls = "hn";
          else if (m[5]) cls = "hn";
          else if (m[7]) { out += esc(m[6]) + '<span class="hf">' + esc(m[7]) + "</span>"; last = re.lastIndex; continue; }
          else if (m[8]) cls = "hf";
          else cls = "hc";
          out += '<span class="' + cls + '">' + esc(txt) + "</span>";
          last = re.lastIndex;
        }
        el.innerHTML = out + esc(src.slice(last));
      });
    })();
    (function () {
      var box = document.getElementById("doc-toc");
      if (!box) return;
      var hs = [].filter.call(document.querySelectorAll(".doc h2[id]"), function (h) { return h.getClientRects().length; });
      hs.forEach(function (h) {
        var a = document.createElement("a");
        a.href = "#" + h.id;
        a.textContent = h.innerText.trim();
        box.appendChild(a);
      });
      if (!hs.length) { box.remove(); return; }
      var links = [].slice.call(box.querySelectorAll("a"));
      var mark = function () {
        var cur = 0;
        hs.forEach(function (h, i) { if (h.getBoundingClientRect().top < 120) cur = i; });
        links.forEach(function (a, i) { a.classList.toggle("on", i === cur); });
      };
      addEventListener("scroll", mark, { passive: true });
      mark();
    })();
    (function () {
      var btn = document.getElementById("lang"), menu = document.getElementById("lang-menu");
      if (!btn || !menu) return;
      var cur = document.documentElement.lang;
      menu.querySelectorAll("button").forEach(function (b) {
        var on = b.dataset.l === cur;
        b.setAttribute("aria-checked", String(on));
        if (on) document.getElementById("lang-cur").textContent = b.textContent;
      });
      function close() { menu.classList.remove("open"); btn.setAttribute("aria-expanded", "false"); }
      btn.addEventListener("click", function (e) { e.stopPropagation(); btn.setAttribute("aria-expanded", String(menu.classList.toggle("open"))); });
      menu.addEventListener("click", function (e) {
        var b = e.target.closest("button[data-l]");
        if (!b) return;
        var l = b.dataset.l, p = location.pathname.replace(/^\/zh-Hans(?=\/|$)/, "") || "/";
        document.cookie = "ou_lang=" + l + ";path=/;max-age=31536000;samesite=lax";
        // ja / es exist for the landing page only; English and Chinese keep the page you are reading
        var to = l === "ja" ? "/ja" : l === "es" ? "/es" : l === "zh-CN" ? "/zh-Hans" + (p === "/" ? "" : p) : p;
        location.assign(to + (l === "ja" || l === "es" ? "" : location.search + location.hash));
      });
      document.addEventListener("click", close);
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
    })();
  </script>
</Base>

<style is:global>
  html:not([lang="zh-CN"]) [lang="zh-CN"],
  html[lang="zh-CN"] [lang="en"] { display: none !important; }

  .doc-top { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: saturate(1.4) blur(16px); -webkit-backdrop-filter: saturate(1.4) blur(16px); position: sticky; top: 0; z-index: 50; }
  .doc-top-in { max-width: 1160px; margin: 0 auto; height: 68px; padding: 0 28px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 32px; }
  .doc-brand { display: flex; align-items: center; gap: 10px; color: var(--ink); font-size: 17px; font-weight: 600; letter-spacing: -.01em; text-decoration: none; }
  .doc-brand b { font-weight: 600; }
  .doc-mk { width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(135deg, #0f9d58, #0a5c34); display: grid; place-items: center; flex: none; }
  .doc-mk svg { width: 16px; height: 16px; }
  .doc-links { display: flex; gap: 28px; justify-self: center; font-size: 14.5px; }
  .doc-links a { color: var(--muted); text-decoration: none; transition: color .15s; }
  .doc-links a:hover { color: var(--ink); }
  .doc-nav { justify-self: end; display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .doc-lang, .doc-signin { height: 38px; padding: 0 14px; display: inline-flex; align-items: center; border: 1px solid var(--line-2); border-radius: 10px; background: var(--surface); color: var(--ink); font: 14px var(--sans); cursor: pointer; text-decoration: none; transition: .15s; }
  .doc-lang:hover, .doc-signin:hover { border-color: var(--faint); }
  @media (max-width: 560px) { .doc-top-in { display: flex; padding: 0 16px; gap: 16px; } .doc-links { gap: 16px; } .doc-nav { margin-left: auto; } }

  .doc-layout.has-toc { max-width: 1160px; margin: 0 auto; padding: 0 28px; display: grid; grid-template-columns: 200px minmax(0, 760px); gap: 56px; }
  .doc-layout.has-toc .doc { margin: 0; padding-left: 0; padding-right: 0; }
  .doc-toc { position: sticky; top: 92px; align-self: start; margin-top: 52px; display: flex; flex-direction: column; gap: 2px; font-size: 14px; max-height: calc(100vh - 120px); overflow-y: auto; border-left: 1px solid var(--line); }
  .doc-toc a { color: var(--muted); text-decoration: none; padding: 5px 14px; margin-left: -1px; border-left: 2px solid transparent; }
  .doc-toc a:hover { color: var(--ink); }
  .doc-toc a.on { color: var(--ink); border-left-color: var(--accent); font-weight: 500; }
  @media (max-width: 960px) { .doc-layout.has-toc { display: block; padding: 0; } .doc-layout.has-toc .doc { padding-left: 20px; padding-right: 20px; } .doc-toc { display: none; } }
  .doc { max-width: 760px; margin: 0 auto; padding: 48px 20px 32px; line-height: 1.7; font-size: 15.5px; }
  .doc h1 { font: 400 40px/1.15 var(--serif, "Instrument Serif", serif); letter-spacing: -.01em; margin: 0 0 8px; }
  html[lang="zh-CN"] .doc h1 { font-family: var(--sans); font-weight: 700; font-size: 32px; }
  .doc .lede { color: var(--muted); font-size: 17px; margin: 0 0 28px; }
  html { scroll-padding-top: 88px; }
  .doc h2, .doc h3 { font-family: var(--sans); }
  .doc h2 { font-size: 20px; font-weight: 600; margin: 40px 0 10px; padding-top: 8px; border-top: 1px solid var(--line); letter-spacing: -.01em; }
  .doc h3 { font-size: 16px; font-weight: 600; margin: 26px 0 6px; }
  .doc p, .doc ul, .doc ol, .doc table, .doc pre { margin: 0 0 14px; }
  .doc ul, .doc ol { padding-left: 22px; }
  .doc li { margin: 4px 0; }
  .doc a { color: var(--accent); text-underline-offset: 3px; }
  .doc strong { font-weight: 600; }
  .doc code { font: 13px var(--mono); background: var(--surface-2); border: 1px solid var(--line); border-radius: 6px; padding: 1px 6px; overflow-wrap: anywhere; }
  .doc pre { background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; overflow-x: auto; line-height: 1.55; }
  .doc .hs { color: var(--accent); }
  .doc .hk { color: var(--ink); font-weight: 600; }
  .doc .hn { color: var(--warn); }
  .doc .hf { color: #5b7cff; }
  .doc .hc { color: var(--faint); font-style: italic; }
  .doc pre code { background: none; border: 0; padding: 0; font-size: 13px; overflow-wrap: normal; }
  .doc table { width: 100%; border-collapse: collapse; font-size: 14px; display: block; overflow-x: auto; }
  .doc th, .doc td { text-align: left; vertical-align: top; padding: 8px 12px; border-bottom: 1px solid var(--line); }
  .doc th { font: 500 11.5px var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--faint); background: var(--surface-2); white-space: nowrap; }
  /* settings tables: keep variable names on one line and give them the room they need */
  .doc table.vars td:first-child, .doc table.vars-3 td:nth-child(2) { white-space: nowrap; }
  .doc table.vars td:first-child code, .doc table.vars-3 td:nth-child(2) code { overflow-wrap: normal; }
  .doc table.vars td:first-child { min-width: 240px; }
  .doc table.vars-3 td:first-child { min-width: 110px; }
  .doc table.vars-3 td:nth-child(2) { min-width: 220px; }
  .doc .note { border: 1px solid var(--line); border-left: 3px solid var(--accent); background: var(--surface); border-radius: 10px; padding: 10px 14px; color: var(--muted); }
  .doc .ep { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; margin: 18px 0 6px; }
  .doc .ep .m { font: 600 12px var(--mono); padding: 2px 8px; border-radius: 6px; background: var(--surface-2); border: 1px solid var(--line-2); }
  .doc .ep .m.get { color: var(--accent); }
  .doc .ep .m.post { color: var(--warn); }
  .doc .ep .m.patch { color: var(--warn); }
  .doc .ep .m.delete { color: var(--down); }
  .doc .ep code { font-size: 14px; background: none; border: 0; padding: 0; }
  .doc .toc { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0 0 8px; font-size: 14px; }
  .doc-updated { color: var(--faint); font-size: 13px; margin-top: 40px; }
  .site-foot { border-top: 1px solid var(--line); padding: 64px 0 40px; font-size: 14.5px; color: var(--muted); margin-top: 32px; }
  .sf-wrap { max-width: 1160px; margin: 0 auto; padding: 0 28px; }
  .sf-grid { display: grid; grid-template-columns: 1.8fr 1fr 1fr 1fr; gap: 40px; }
  .sf-grid h4 { font: 500 12px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--faint); margin: 0 0 16px; }
  .sf-grid a { display: block; padding: 5px 0; color: var(--muted); text-decoration: none; transition: color .15s; }
  .sf-grid a:hover { color: var(--ink); }
  .sf-grid a.sf-brand { display: inline-flex; flex-direction: row; align-items: center; gap: 10px; margin-bottom: 14px; padding: 0; color: var(--ink); }
  .sf-grid a.sf-status { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; font-size: 13px; color: var(--ink); background: var(--surface); }
  .sf-status[hidden] { display: none !important; }
  .sf-status i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .sf-status.degraded i { background: #d9a300; } .sf-status.outage i { background: #d93025; }
  .sf-tag { max-width: 34ch; margin: 0; }
  .sf-bot { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; gap: 12px; justify-content: space-between; font-size: 13px; color: var(--faint); }
  .sf-bot .lang { margin-left: auto; position: relative; }
  .lang-btn { height: 38px; display: flex; align-items: center; gap: 8px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: 14px var(--sans); cursor: pointer; transition: .15s; }
  .lang-btn:hover, .lang-btn[aria-expanded=true] { border-color: var(--line-2); }
  .lang-btn svg { width: 15px; height: 15px; color: var(--muted); }
  .lang-btn .chev { width: 12px; height: 12px; transition: transform .15s; }
  .lang-btn[aria-expanded=true] .chev { transform: rotate(180deg); }
  .lang-menu { position: absolute; right: 0; bottom: calc(100% + 6px); min-width: 150px; padding: 5px; margin: 0; list-style: none; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); box-shadow: 0 12px 32px rgba(0,0,0,.14); z-index: 60; display: none; }
  .lang-menu.open { display: block; }
  .lang-menu button { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 10px; border: 0; border-radius: 8px; background: none; font: 14px var(--sans); text-align: left; cursor: pointer; color: var(--ink); }
  .lang-menu button:hover { background: rgba(127,127,127,.12); }
  .lang-menu button[aria-checked=true] { font-weight: 600; }
  .lang-menu button[aria-checked=true]::after { content: "✓"; color: var(--accent); }
  @media (max-width: 760px) { .sf-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .doc { padding-top: 32px; } .doc h1 { font-size: 32px; } }
</style>
