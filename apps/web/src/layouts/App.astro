---
import Base from "./Base.astro";
import ProjectSwitcher from "../components/ProjectSwitcher";
import TopBar from "../components/TopBar";
const { title = "OpenUptime", active = "monitors" } = Astro.props as { title?: string; active?: string };
// The shell is static HTML: no server data. The browser fetches identity, counts and the page's data in parallel (lib/boot.ts)
// and translates the `data-t` labels, so this file renders the same bytes for everyone.
const I: Record<string, string> = {
  monitors: "<rect x='3' y='4' width='18' height='12' rx='2.5'/><path d='M8 20h8M12 16v4'/>",
  incidents: "<path d='M12 3.5 2.8 19.5h18.4L12 3.5z'/><path d='M12 10v4.5M12 17.4v.1'/>",
  "status-pages": "<circle cx='12' cy='12' r='9'/><path d='M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18'/>",
  alerting: "<path d='M6 17V11a6 6 0 1 1 12 0v6l1.5 2h-15L6 17z'/><path d='M10 21h4'/>",
  maintenance: "<rect x='3' y='5' width='18' height='16' rx='2.5'/><path d='M3 10h18M8 3v4M16 3v4'/>",
  team: "<circle cx='9' cy='8' r='3.4'/><path d='M2.8 19a6.2 6.2 0 0 1 12.4 0M16 5a3.4 3.4 0 0 1 0 6.3M18.5 14.2A6.2 6.2 0 0 1 21.5 19'/>",
  usage: "<path d='M4 20V10M10 20V4M16 20v-7M22 20H2'/>",
  settings: "<circle cx='12' cy='12' r='3'/><path d='M12 2.5v2.4M12 19.1v2.4M4.6 6.6l1.7 1.7M17.7 15.7l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.6 17.4l1.7-1.7M17.7 8.3l1.7-1.7'/>",
};
const main = [
  ["monitors", "/app", "Monitors"],
  ["incidents", "/app/incidents", "Incidents"],
  ["status-pages", "/app/status-pages", "Status pages"],
  ["maintenance", "/app/maintenance", "Maintenance"],
];
// alert channels belong to the workspace: one set shared by every project
const workspace = [
  ["alerting", "/app/alerting", "Alerting"],
  ["team", "/app/team", "Team"],
  ["usage", "/app/usage", "Plan & usage"],
  ["settings", "/app/settings", "Settings"],
];
const crumb = [...main, ...workspace].find(([k]) => k === active)?.[2] ?? title;
---
<Base noindex title={`${title} · OpenUptime`} router={false}>
  <div class="app" id="app">
    <div class="scrim" id="scrim"></div>
    <aside class="side">
      <a class="brand" href="/app">
        <span class="mk"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 4 12 2.5-6H21"/></svg></span>
        <span class="bn">OpenUptime</span>
      </a>
      <ProjectSwitcher client:only="react" />
      <div class="nl">
      {main.map(([k, href, label]) => (
        <a data-nav={k} class={`nav ${active === k ? "on" : ""}`} href={href}><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={I[k]} /><span data-t>{label}</span>{(k === "monitors" || k === "incidents") && <em data-count={k} hidden></em>}</a>
      ))}
      <div class="nav-l" data-t>Workspace</div>
      {workspace.map(([k, href, label]) => (
        <a data-nav={k} class={`nav ${active === k ? "on" : ""}`} href={href} hidden={k === "usage" && active !== "usage"} data-metered={k === "usage" ? "" : undefined}><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={I[k]} /><span data-t>{label}</span></a>
      ))}
      </div>
      <div class="sp"></div>
      <div class="me-wrap" id="me-wrap">
        <div class="menu card" id="me-menu" hidden>
          <div class="mi-h"><b data-me="name"></b><small data-me="email"></small></div>
          <div class="sep"></div>
          <a data-nav="account" class="mi" href="/app/account"><span data-t>Account settings</span></a>
          <a data-nav="api-keys" class="mi" href="/app/api-keys"><span data-t>API keys</span></a>
          <button class="mi signout"><span data-t>Sign out</span><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 8l-4 4 4 4M6 12h10"/></svg></button>
        </div>
        <button class="me" id="me-btn" aria-haspopup="menu" aria-expanded="false">
          <div><span data-me="name"></span><small data-me="email"></small></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5-5 5 5"/></svg>
        </button>
      </div>
    </aside>
    <div class="main">
      <div class="bar">
        <button class="icon-btn menu-btn" id="menu-btn" aria-label="Menu"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
        <div class="crumb"><b data-t>{crumb}</b></div>
        <div class="bar-r"><TopBar client:only="react" /></div>
      </div>
      <main class="page"><slot /></main>
    </div>
    <nav class="tabs" aria-label="Primary">
      {main.slice(0, 4).map(([k, href, label]) => (
        <a data-nav={k} class={active === k ? "on" : ""} href={href}><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={I[k]} /><span data-t>{label}</span></a>
      ))}
      <button id="tab-more" class={["alerting", "team", "settings"].includes(active) ? "on" : ""}><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="5" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="19" cy="12" r="1.2"/></svg><span data-t>More</span></button>
    </nav>
  </div>
  <script>import "../lib/boot";</script>
  <script>import { registerServiceWorker } from "../lib/pwa";
    registerServiceWorker();</script>
  <script is:inline>
    // delegated, bound once: the DOM is swapped on soft navigation but `document` survives
    if (!window.__ouApp) {
      window.__ouApp = 1;
      var shut = function () {
        var m = document.getElementById("me-menu"), b = document.getElementById("me-btn");
        if (m) m.hidden = true;
        if (b) b.setAttribute("aria-expanded", "false");
      };
      document.addEventListener("click", function (e) {
        var el = e.target.closest ? e.target : e.target.parentElement;
        var app = document.getElementById("app");
        if (el.closest("#menu-btn, #tab-more")) return app.classList.toggle("open");
        if (el.closest("#scrim")) return app.classList.remove("open");
        if (el.closest("#me-btn")) {
          var m = document.getElementById("me-menu");
          m.hidden = !m.hidden;
          return document.getElementById("me-btn").setAttribute("aria-expanded", String(!m.hidden));
        }
        if (el.closest(".signout")) {
          return fetch("/api/auth/sign-out", { method: "POST", credentials: "include", headers: { "content-type": "application/json" }, body: "{}" })
            .then(function () { location.href = (/^\/zh-Hans(\/|$)/.test(location.pathname) ? "/zh-Hans" : "") + "/login"; });
        }
        shut();
      });
      var counts = function () {
        fetch("/api/counts", { credentials: "include" }).then(function (r) { return r.ok ? r.json() : null; }).then(function (c) {
          if (!c) return;
          document.querySelectorAll("[data-count]").forEach(function (el) {
            var k = el.getAttribute("data-count"), n = c[k];
            if (n == null) return;
            el.textContent = n;
            el.hidden = !(n > 0);
            el.className = k === "incidents" && n > 0 ? "cnt" : "";
          });
        }).catch(function () {});
      };
      // lib/boot.ts paints the first counts; refresh after create/resolve actions
      window.addEventListener("ou:changed", counts);
      document.addEventListener("keydown", function (e) {
        if (e.key !== "Escape") return;
        shut();
        var app = document.getElementById("app");
        if (app) app.classList.remove("open");
      });
    }
  </script>
</Base>
