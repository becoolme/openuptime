const callExample = JSON.stringify({ mcpConfig: { transport: "auto", requiredTools: ["get_status"], schemaCheck: true, driftPolicy: "down", toolCall: { enabled: true, name: "get_status", arguments: { environment: "test" }, assertions: [{ path: "/structuredContent/ok", operator: "equals", value: true }] } } }, null, 2);
const oauthExample = JSON.stringify({ mode: "client_credentials", issuer: "https://auth.example.com", clientId: "YOUR_CLIENT_ID", clientSecret: "YOUR_CLIENT_SECRET", scopes: ["mcp:read"], resource: "https://mcp.example.com", tokenAuthMethod: "client_secret_basic" }, null, 2);
