PROBE_REGIONS='{"office":{"url":"https://office-probe.example.com/","name":"Office network","private":true}}'
# Node probe inside that network
ALLOW_PRIVATE_TARGETS=true
# Set the same PROBE_SECRET on the coordinator and probe.`;
