{
  "name": "openuptime",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:api": "pnpm --filter @openuptime/api dev",
    "dev:web": "pnpm --filter @openuptime/web dev",
    "db:generate": "pnpm --filter @openuptime/db-pg generate",
    "db:migrate": "pnpm --filter @openuptime/db-pg migrate",
    "typecheck": "pnpm -r typecheck"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/becoolme/openuptime.git"
  },
  "homepage": "https://github.com/becoolme/openuptime#readme",
  "bugs": {
    "url": "https://github.com/becoolme/openuptime/issues"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
